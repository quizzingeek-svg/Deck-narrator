# Optional keys. Copy this file to ".env" (the start script does it for you) and fill in what you have.
# Everything works without keys except AI explanations, live AI answers and translation.

# --- AI model (pick ONE) ---------------------------------------------------
# Google Gemini, free tier. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq, free tier: https://console.groq.com/keys
GROQ_API_KEY=
# OpenAI (paid). Also used for OpenAI voices if you choose that engine.
OPENAI_API_KEY=

# Advanced: any OpenAI-compatible endpoint (overrides the above)
# LLM_PROVIDER=Custom OpenAI-compatible
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=

# --- Premium voices (optional; free Microsoft neural voices are the default) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# --- Speech recognition ---------------------------------------------------------
# Built-in offline Whisper model: base (default). "small" works only if the image was built with it.
WHISPER_MODEL=base
# Optional cloud transcription key (OpenAI-compatible /audio/transcriptions)
STT_API_KEY=
